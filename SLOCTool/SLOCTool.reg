REGEDIT
; This .REG file may be used by your SETUP program.
;   If a SETUP program is not available, the entries below will be
;   registered in your InitInstance automatically with a call to
;   CWinApp::RegisterShellFileTypes and COleObjectFactory::UpdateRegistryAll.

HKEY_CLASSES_ROOT\.sloc = SLOCTool.Document
HKEY_CLASSES_ROOT\SLOCTool.Document\shell\open\command = SLOCTool.EXE %1
HKEY_CLASSES_ROOT\SLOCTool.Document\shell\open\ddeexec = [open("%1")]
HKEY_CLASSES_ROOT\SLOCTool.Document\shell\open\ddeexec\application = SLOCTool
    ; note: the application is optional
    ;  (it defaults to the app name in "command")

HKEY_CLASSES_ROOT\SLOCTool.Document = SLOCTool.Document


HKEY_CLASSES_ROOT\SLOCTool.Document\protocol\StdFileEditing\server = SLOCTool.EXE
HKEY_CLASSES_ROOT\SLOCTool.Document\protocol\StdFileEditing\verb\0 = &Edit
HKEY_CLASSES_ROOT\SLOCTool.Document\Insertable =
HKEY_CLASSES_ROOT\SLOCTool.Document\CLSID = {AEC59B27-8E77-4455-A3B7-00726EC23278}

HKEY_CLASSES_ROOT\CLSID\{AEC59B27-8E77-4455-A3B7-00726EC23278} = SLOCTool.Document
HKEY_CLASSES_ROOT\CLSID\{AEC59B27-8E77-4455-A3B7-00726EC23278}\DefaultIcon = SLOCTool.EXE,1
HKEY_CLASSES_ROOT\CLSID\{AEC59B27-8E77-4455-A3B7-00726EC23278}\LocalServer32 = SLOCTool.EXE
HKEY_CLASSES_ROOT\CLSID\{AEC59B27-8E77-4455-A3B7-00726EC23278}\ProgId = SLOCTool.Document
HKEY_CLASSES_ROOT\CLSID\{AEC59B27-8E77-4455-A3B7-00726EC23278}\MiscStatus = 32
HKEY_CLASSES_ROOT\CLSID\{AEC59B27-8E77-4455-A3B7-00726EC23278}\AuxUserType\3 = SLOCTool
HKEY_CLASSES_ROOT\CLSID\{AEC59B27-8E77-4455-A3B7-00726EC23278}\AuxUserType\2 = SLOCTool
HKEY_CLASSES_ROOT\CLSID\{AEC59B27-8E77-4455-A3B7-00726EC23278}\Insertable = 
HKEY_CLASSES_ROOT\CLSID\{AEC59B27-8E77-4455-A3B7-00726EC23278}\verb\1 = &Open,0,2
HKEY_CLASSES_ROOT\CLSID\{AEC59B27-8E77-4455-A3B7-00726EC23278}\verb\0 = &Edit,0,2
HKEY_CLASSES_ROOT\CLSID\{AEC59B27-8E77-4455-A3B7-00726EC23278}\InprocHandler32 = ole32.dll

